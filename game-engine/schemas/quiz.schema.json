{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuizGameConfig",
  "type": "object",
  "required": [
    "gameId",
    "template",
    "lessonId",
    "ageLevel",
    "category",
    "tier",
    "item_id",
    "questions",
    "rewards",
    "successThresholdPct"
  ],
  "properties": {
    "gameId": {
      "type": "string"
    },
    "template": {
      "const": "quiz"
    },
    "lessonId": {
      "type": "string"
    },
    "ageLevel": {
      "type": "string",
      "enum": [
        "Creche",
        "Nursery",
        "KG1",
        "KG2",
        "Primary"
      ]
    },
    "category": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "item_id": {
      "type": "string"
    },
    "series_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "integer",
      "minimum": 1
    },
    "durationTargetSec": {
      "type": "integer",
      "minimum": 15,
      "maximum": 300
    },
    "promptMode": {
      "type": "string",
      "enum": ["text", "image", "audio", "context"],
      "description": "How the question is presented"
    },
    "responseMode": {
      "type": "string",
      "enum": ["text", "image", "audio"],
      "description": "How options are displayed and how the learner responds"
    },
    "context": {
      "type": "string",
      "description": "Contextual riddle/description when promptMode is 'context'"
    },
    "characters": {
      "type": "array",
      "description": "Recurring child-friendly characters. Image > Emoji > Text: provide an image URL for best visual, emoji as fallback, name as last resort.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Character name (e.g. Alex, Maya, Tobi)"
          },
          "image": {
            "type": "string",
            "description": "Character image URL (preferred over emoji). Asset key like 'media/{lessonId}/character-alex.webp'"
          },
          "emoji": {
            "type": "string",
            "description": "Character emoji fallback if no image (e.g. 👦, 🧒)"
          },
          "personality": {
            "type": "string",
            "description": "Brief personality trait (e.g. curious, playful)"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "options",
          "correctIndex"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "description": "The core question text (kept for backward compatibility)"
          },
          "promptAudio": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "scenario": {
            "type": "string",
            "description": "Short story/situation wrapping the question (e.g. 'Alex is at the zoo. He sees a big animal. Sam says: ___ is very tall.')"
          },
          "characterName": {
            "type": "string",
            "description": "Name of the character involved in this question"
          },
          "characterImage": {
            "type": "string",
            "description": "Character image URL for this question (preferred over characterEmoji). Asset key like 'media/{lessonId}/character-maya.webp'"
          },
          "characterEmoji": {
            "type": "string",
            "description": "Character emoji fallback if no image (e.g. 👦)"
          },
          "setting": {
            "type": "string",
            "description": "Where the scenario takes place (e.g. 'at the zoo', 'at school')"
          },
          "settingImage": {
            "type": "string",
            "description": "Setting/location image URL (preferred over setting text). Asset key like 'media/{lessonId}/zoo.webp'"
          },
          "hint": {
            "type": "string",
            "description": "Encouraging hint shown after wrong answer (e.g. 'Sam is a boy, so let's use a word for boys!')"
          },
          "speechText": {
            "type": "string",
            "description": "Exact text to read aloud via TTS (overrides scenario+prompt for voice)"
          },
          "feedbackCorrect": {
            "type": "string",
            "description": "Custom encouraging message for correct answer"
          },
          "feedbackWrong": {
            "type": "string",
            "description": "Custom gentle message for wrong answer"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "image"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                }
              }
            }
          },
          "correctIndex": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rewards": {
      "type": "object",
      "required": [
        "starsOnComplete",
        "xp"
      ],
      "properties": {
        "starsOnComplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "successThresholdPct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
