{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FillInBlankGameConfig",
  "type": "object",
  "required": ["gameId", "template", "lessonId", "ageLevel", "category", "tier", "item_id", "sentence", "blanks", "wordBank", "rewards", "successThresholdPct"],
  "properties": {
    "gameId": { "type": "string" },
    "template": { "const": "fill-in-blank" },
    "lessonId": { "type": "string" },
    "ageLevel": { "type": "string", "enum": ["Creche", "Nursery", "KG1", "KG2", "Primary"] },
    "category": { "type": "string" },
    "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "item_id": { "type": "string" },
    "durationTargetSec": { "type": "integer", "minimum": 15, "maximum": 300 },
    "promptMode": { "type": "string", "enum": ["text", "image", "audio", "context"], "description": "How the sentence is presented" },
    "responseMode": { "type": "string", "enum": ["text"], "description": "Fill-in-blank responses are always text" },
    "context": { "type": "string", "description": "Contextual clue when promptMode is 'context'" },
    "characters": {
      "type": "array",
      "description": "Recurring child-friendly characters. Image > Emoji > Text.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "image": { "type": "string", "description": "Character image URL (preferred over emoji)" },
          "emoji": { "type": "string", "description": "Character emoji fallback" },
          "personality": { "type": "string" }
        }
      }
    },
    "scenario": {
      "type": "string",
      "description": "Short story/scenario wrapping the fill-in-blank game (shown to child)"
    },
    "hint": {
      "type": "string",
      "description": "Encouraging hint shown after wrong answer"
    },
    "feedbackCorrect": {
      "type": "string",
      "description": "Custom encouraging message for correct fill"
    },
    "feedbackWrong": {
      "type": "string",
      "description": "Custom gentle message for wrong fill"
    },
    "speechText": {
      "type": "string",
      "description": "Exact text to read aloud via TTS"
    },
    "sentence": { "type": "string", "minLength": 10 },
    "blanks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "answer"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "answer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "wordBank": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": { "type": "string" }
    },
    "rewards": {
      "type": "object",
      "required": ["starsOnComplete", "xp"],
      "properties": {
        "starsOnComplete": { "type": "integer", "minimum": 0, "maximum": 3 },
        "xp": { "type": "integer", "minimum": 0 }
      }
    },
    "successThresholdPct": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
