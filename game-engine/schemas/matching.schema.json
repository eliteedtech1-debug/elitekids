{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchingGameConfig",
  "type": "object",
  "required": [
    "gameId",
    "template",
    "lessonId",
    "ageLevel",
    "category",
    "tier",
    "item_id",
    "assets",
    "rewards",
    "successThresholdPct"
  ],
  "properties": {
    "gameId": {
      "type": "string"
    },
    "template": {
      "const": "matching"
    },
    "lessonId": {
      "type": "string"
    },
    "ageLevel": {
      "type": "string",
      "enum": [
        "Creche",
        "Nursery",
        "KG1",
        "KG2",
        "Primary"
      ]
    },
    "category": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "item_id": {
      "type": "string"
    },
    "series_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "integer",
      "minimum": 1
    },
    "durationTargetSec": {
      "type": "integer",
      "minimum": 15,
      "maximum": 300
    },
    "promptMode": {
      "type": "string",
      "enum": ["text", "image", "audio"],
      "description": "How the left side of the match is presented"
    },
    "responseMode": {
      "type": "string",
      "enum": ["text", "image", "audio"],
      "description": "How the right side (response) is presented"
    },
    "characters": {
      "type": "array",
      "description": "Recurring child-friendly characters. Image > Emoji > Text.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "image": { "type": "string", "description": "Character image URL (preferred over emoji)" },
          "emoji": { "type": "string", "description": "Character emoji fallback" },
          "personality": { "type": "string" }
        }
      }
    },
    "scenario": {
      "type": "string",
      "description": "Short story/scenario wrapping the matching game (shown to child)"
    },
    "hint": {
      "type": "string",
      "description": "Encouraging hint shown after wrong match"
    },
    "feedbackCorrect": {
      "type": "string",
      "description": "Custom encouraging message for correct match"
    },
    "feedbackWrong": {
      "type": "string",
      "description": "Custom gentle message for wrong match"
    },
    "speechText": {
      "type": "string",
      "description": "Exact text to read aloud via TTS"
    },
    "assets": {
      "type": "object",
      "required": [
        "background",
        "items"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "id",
              "image",
              "matches"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "audio": {
                "type": "string"
              },
              "matches": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "rewards": {
      "type": "object",
      "required": [
        "starsOnComplete",
        "xp"
      ],
      "properties": {
        "starsOnComplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "successThresholdPct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}