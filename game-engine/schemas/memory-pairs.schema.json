{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryPairsGameConfig",
  "type": "object",
  "required": [
    "gameId",
    "template",
    "lessonId",
    "ageLevel",
    "category",
    "tier",
    "item_id",
    "assets",
    "rewards",
    "successThresholdPct"
  ],
  "properties": {
    "gameId": {
      "type": "string"
    },
    "template": {
      "const": "memory-pairs"
    },
    "lessonId": {
      "type": "string"
    },
    "ageLevel": {
      "type": "string",
      "enum": [
        "Creche",
        "Nursery",
        "KG1",
        "KG2",
        "Primary"
      ]
    },
    "category": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "item_id": {
      "type": "string"
    },
    "series_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "type": "string"
    },
    "durationTargetSec": {
      "type": "integer",
      "minimum": 15,
      "maximum": 300
    },
    "promptMode": {
      "type": "string",
      "enum": ["text", "image", "audio"],
      "description": "How each card face is presented"
    },
    "responseMode": {
      "type": "string",
      "enum": ["text", "image", "audio"],
      "description": "How the child responds — always by flipping cards"
    },
    "assets": {
      "type": "object",
      "required": [
        "background",
        "items"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 16,
          "description": "Every card is an item; partner cards point at each other via 'matches'. Total items must be even (pairs).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "image",
              "matches"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "audio": {
                "type": "string"
              },
              "matches": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "rewards": {
      "type": "object",
      "required": [
        "starsOnComplete",
        "xp"
      ],
      "properties": {
        "starsOnComplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "successThresholdPct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
