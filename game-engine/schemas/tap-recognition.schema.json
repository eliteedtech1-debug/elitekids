{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TapRecognitionGameConfig",
  "type": "object",
  "required": [
    "gameId",
    "template",
    "lessonId",
    "ageLevel",
    "category",
    "tier",
    "item_id",
    "assets",
    "rewards",
    "successThresholdPct"
  ],
  "properties": {
    "gameId": {
      "type": "string"
    },
    "template": {
      "const": "tap-recognition"
    },
    "lessonId": {
      "type": "string"
    },
    "ageLevel": {
      "type": "string",
      "enum": [
        "Creche",
        "Nursery",
        "KG1",
        "KG2",
        "Primary"
      ]
    },
    "category": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "item_id": {
      "type": "string"
    },
    "series_id": {
      "type": "string"
    },
    "unit_number": {
      "type": "integer",
      "minimum": 1
    },
    "durationTargetSec": {
      "type": "integer",
      "minimum": 15,
      "maximum": 300
    },
    "prompt": {
      "type": "string",
      "description": "e.g. 'Tap the red apple' \u2014 must be understandable without reading (audio hint optional)"
    },
    "promptMode": {
      "type": "string",
      "enum": ["text", "image", "audio", "context"],
      "description": "How the concept is presented: text prompt, image to identify, audio to listen, or context/riddle"
    },
    "responseMode": {
      "type": "string",
      "enum": ["text", "image", "audio"],
      "description": "How the learner responds: tap text labels, tap images, or speak the answer"
    },
    "context": {
      "type": "string",
      "description": "Contextual riddle/description when promptMode is 'context', e.g. 'An animal that says meow'"
    },
    "characters": {
      "type": "array",
      "description": "Recurring child-friendly characters. Image > Emoji > Text.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "image": { "type": "string", "description": "Character image URL (preferred over emoji)" },
          "emoji": { "type": "string", "description": "Character emoji fallback" },
          "personality": { "type": "string" }
        }
      }
    },
    "scenario": {
      "type": "string",
      "description": "Short story/scenario wrapping the tap game (shown to child)"
    },
    "hint": {
      "type": "string",
      "description": "Encouraging hint shown after wrong answer"
    },
    "feedbackCorrect": {
      "type": "string",
      "description": "Custom encouraging message for correct answer"
    },
    "feedbackWrong": {
      "type": "string",
      "description": "Custom gentle message for wrong answer"
    },
    "speechText": {
      "type": "string",
      "description": "Exact text to read aloud via TTS"
    },
    "assets": {
      "type": "object",
      "required": [
        "background",
        "objects",
        "correctId"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "image"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "audio": {
                "type": "string"
              }
            }
          }
        },
        "correctId": {
          "type": "string",
          "description": "id of the object the child must tap"
        },
        "promptAudio": {
          "type": "string"
        }
      }
    },
    "rewards": {
      "type": "object",
      "required": [
        "starsOnComplete",
        "xp"
      ],
      "properties": {
        "starsOnComplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "successThresholdPct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}