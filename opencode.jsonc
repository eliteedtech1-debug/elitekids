{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "mcp": {
    "elitekids-api": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-fetch"],
      "enabled": true
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "elitekids-api_*": "allow"
  }
}
