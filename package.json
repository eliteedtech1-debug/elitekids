{
  "name": "elite-kids",
  "version": "0.1.0",
  "private": true,
  "description": "EliteKids — nursery learning platform (root workspace)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd backend && node src/index.js",
    "dev:web": "cd frontend && VITE_API_URL=http://localhost:34600 npx vite --host --port 34601",
    "start:api": "cd backend && node src/index.js",
    "start:fe": "cd frontend && VITE_API_URL=http://localhost:34600 vite --host --port 34601",
    "build": "cd frontend && npm run build",
    "test": "cd backend && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
