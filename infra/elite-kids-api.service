[Unit]
Description=Elite Kids API Server
After=network.target mysql.service redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/var/www/html/elite/elite-kids/backend
ExecStart=/home/dev/.nvm/versions/node/v22.23.2/bin/node src/index.js
Restart=on-failure
RestartSec=10
EnvironmentFile=/var/www/html/elite/elite-kids/backend/.env

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
