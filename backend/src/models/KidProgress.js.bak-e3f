'use strict';
/**
 * kids_progress (elite_content) — child progress: game completions, stars, XP.
 * The unique key on (child, lesson, config, idempotency_key) makes
 * game:complete retries idempotent — no double-counting.
 */
module.exports = (sequelize, DataTypes) => {
  const KidProgress = sequelize.define(
    'KidProgress',
    {
      id: { type: DataTypes.STRING(50), primaryKey: true },
      school_id: { type: DataTypes.STRING(20), allowNull: false },
      branch_id: { type: DataTypes.STRING(20), allowNull: false },
      child_admission_no: { type: DataTypes.STRING(50), allowNull: false },
      lesson_id: { type: DataTypes.STRING(50), allowNull: false },
      game_config_id: { type: DataTypes.STRING(50), allowNull: true },
      score: { type: DataTypes.INTEGER, allowNull: false, defaultValue: 0 },
      stars_earned: { type: DataTypes.TINYINT, allowNull: false, defaultValue: 0 },
      xp: { type: DataTypes.INTEGER, allowNull: false, defaultValue: 0 },
      completed_at: { type: DataTypes.DATE, allowNull: false },
      idempotency_key: { type: DataTypes.STRING(100), allowNull: true },
      difficulty: { type: DataTypes.STRING(20), allowNull: true },
    },
    {
      tableName: 'kids_progress',
      indexes: [
        {
          name: 'uq_kids_progress_dedupe',
          unique: true,
          fields: ['child_admission_no', 'lesson_id', 'game_config_id', 'idempotency_key'],
        },
        { name: 'kids_progress_child', fields: ['child_admission_no'] },
        { name: 'kids_progress_lesson', fields: ['lesson_id'] },
      ],
    }
  );
  return KidProgress;
};
