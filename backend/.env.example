# ── Database ──────────────────────────────────────────────────────────────────
# Main shared school DB (users, students, teachers, parents, school_setup) —
# READ/use only; never create tables here (see 02-ELITE-INTEGRATION/02).
DB_NAME=elite_db
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# Addon tables live here (kids_* content tables) — same DB the CBT addon uses.
CONTENT_DB_NAME=elite_content
# AI audit log lives here (kids_content_generation_audit).
# CONFIRMED 2026-08-17 (prod VPS): there is no `elite_ai` DB — the AI DB is
# `elite_bot` (elite-api's own default; neither elite-api nor elite-cbt sets
# AI_DB_* in their .env). Keep the default below so the addon works against
# prod out of the box. Set AI_DB_NAME=elite_ai only on servers that provision
# an `elite_ai` DB (see 09-DECISIONS-LOG DEC-002).
AI_DB_NAME=elite_bot
# AUDIT_DB_NAME=elite_logs   # optional (future messaging/audit)

# ── Server ────────────────────────────────────────────────────────────────────
PORT=34600
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────────
# MUST equal elite-api's JWT_SECRET_KEY — ecosystem tokens are shared.
# CONFIRMED 2026-08-17: prod value is identical in elite-api/.env and
# elite-cbt/.env (see 09-DECISIONS-LOG DEC-004). Copy it into your real .env;
# never commit it (this file is only the template).
JWT_SECRET_KEY=change_this_to_the_same_value_as_elite_api
MASTER_PWD=

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# SAME credential as the EliteSMS app (elite-api/.env) — one platform key.
# Never commit the real value.
PAYSTACK_SECRET_KEY=change_this_to_the_same_value_as_elite_api
# Optional public key for client-side Paystack popups (not required by the API).
# PAYSTACK_PUBLIC_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all. Wildcard subdomains
# supported: https://*.elitekids.com.ng
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:34601,https://*.elitekids.com.ng

# ── Redis / Queue (media + game-config generation jobs) ──────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional: REDIS_URL=redis://:password@host:port overrides the two above.

# ── Backblaze B2 (S3-compatible) — rotate the exposed key first ──────────────
B2_ENDPOINT=s3.<region>.backblazeb2.com
B2_REGION=<region>
B2_KEY_ID=replace-me
B2_APPLICATION_KEY=replace-me
B2_BUCKET_BOT=elite-kids-bot-files
B2_BUCKET_DOC=elite-kids-doc-files
B2_BUCKET_MEDIA=elite-kids-media-files
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:34600
# Without B2_ENDPOINT+KEY_ID+APPLICATION_KEY+BUCKET_MEDIA set, uploads fall
# back to LOCAL DISK (synchronous) under MEDIA_STORAGE_DIR — the dev behavior.
MEDIA_STORAGE_DIR=./uploads
# Upload size cap (default 200 MB — covers lesson videos).
MEDIA_MAX_BYTES=209715200
# Jobs ≤ this many bytes ride in the queue payload; larger files are staged
# under tmp/ in B2 first (default 8 MB).
MEDIA_QUEUE_INLINE_BYTES=8388608
# Media worker concurrency (jobs processed in parallel per worker process).
MEDIA_WORKER_CONCURRENCY=5
# Content-generation worker concurrency (AI calls per worker process).
GENERATION_WORKER_CONCURRENCY=2
# Optional sharp knobs for queued image processing:
MEDIA_IMAGE_MAX_WIDTH=1600
MEDIA_IMAGE_QUALITY=75
MEDIA_IMAGE_FORMAT=webp

# ── AI (content generation) — pin exact model versions, never auto-upgrade ───
AI_API_KEY=replace-me
AI_MODEL=gemini-2.5-flash
CLASSIFIER_MODEL=gemini-2.5-flash

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_SQL=false
