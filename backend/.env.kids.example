# EliteKids backend-only integration example
# Copy values into the deployment environment, never into frontend/.env.

ELITE_SMS_API_BASE_URL=
# Set exactly one rotated server credential:
ELITE_SMS_SHARED_JWT=
# Or use the explicitly approved rotated key instead:
# ELITE_SMS_SHARED_API_KEY=
ELITE_SMS_REQUEST_TIMEOUT_MS=8000
ELITE_SMS_MAX_RETRIES=2

# Disabled until the SMS endpoint/auth/scope and pilot are verified.
SMS_CONTEXT_BRIDGE_ENABLED=false
# Production requires the approved school ID; never enable globally.
SMS_CONTEXT_BRIDGE_SCHOOLS=

# Adult-validated flagship pilot; disabled by default and explicitly allow-listed.
KIDS_FLAGSHIP_PILOT_ENABLED=false
KIDS_FLAGSHIP_PILOT_SCHOOLS=

# Development/test only. Production rejects fixtures.
ELITE_SMS_USE_FIXTURE=false

# Practical-first optional feature controls.
KIDS_REALTIME_ENABLED=true
KIDS_AI_GENERATION_ENABLED=true
KIDS_MEDIA_WORKERS_ENABLED=true
KIDS_SOCIAL_ENABLED=false
KIDS_INTELLIGENCE_ENABLED=false
KIDS_PUSH_ENABLED=true
KIDS_MARKETPLACE_ENABLED=false
